# ============================================================
# Roblox Asset AI - Environment Configuration
# ============================================================

# Model Provider Selection: "mock" | "gemini" | "openai" | "anthropic"
# Default is "mock", which uses a high-fidelity procedural generation &
# evaluation engine that requires NO external API keys and runs 100% offline.
DEFAULT_AI_PROVIDER=mock

# Google Gemini API Key (Optional)
# If provided, enables Gemini 2.0 / 1.5 Flash multimodal generation & vision inspection.
GEMINI_API_KEY=

# OpenAI API Key (Optional)
# If provided, enables GPT-4o multimodal generation & vision inspection.
OPENAI_API_KEY=

# Anthropic API Key (Optional)
# If provided, enables Claude 3.5 Sonnet generation & vision inspection.
ANTHROPIC_API_KEY=

# Maximum Self-Improvement Loop Iterations (Default: 3)
MAX_SELF_IMPROVEMENT_ITERATIONS=3

# Quality Target Threshold (0.0 - 1.0, Default: 0.88)
QUALITY_TARGET_THRESHOLD=0.88

# Server Port
PORT=3000
